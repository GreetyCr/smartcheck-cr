---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminosCuerpo from '../components/TerminosCuerpo.astro';
import { lastUpdated } from '../data/terminos';

// Página para clientes que Esteban manda por WhatsApp: mismo texto que
// /terminos-y-condiciones (TerminosCuerpo), con `noindex` y fuera del sitemap.
// El enlace se arma una sola vez; la versión sale de `lastUpdated`.
const mensaje = `He leído y acepto los Términos y Condiciones (versión del ${lastUpdated})`;
const enlaceWhatsApp = 'https://wa.me/50686752713?text=' + encodeURIComponent(mensaje);
---

<BaseLayout
  title="Aceptar los Términos y Condiciones"
  description="Lea los Términos y Condiciones de SmartCheck Costa Rica y acéptelos por WhatsApp con un solo botón."
  noindex
>
  <!-- Hero -->
  <section class="relative py-16 md:py-20 px-4 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-smartcheck-blue via-smartcheck-blue/90 to-smartcheck-blue/80 z-0"></div>
    <div class="absolute top-0 right-0 w-1/3 h-1/3 bg-smartcheck-accent/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-white/10 rounded-full translate-y-1/2 -translate-x-1/2"></div>

    <div class="max-w-4xl mx-auto text-center relative z-10">
      <span class="inline-block px-3 py-1 bg-white/20 text-white rounded-full text-sm font-medium mb-6">LEGAL</span>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Términos y Condiciones</h1>
      <p class="text-white/80">Última actualización: {lastUpdated}</p>
      <p class="text-white/80 mt-2">Al final de la página está el botón para aceptarlos.</p>
      <a href="#aceptar" class="inline-block mt-6 text-white font-medium underline underline-offset-4 hover:text-smartcheck-accent transition-colors">Ir a aceptar ↓</a>
    </div>
  </section>

  <TerminosCuerpo />

  <!-- Aceptar -->
  <section id="aceptar" class="max-w-4xl mx-auto px-4 pb-16 scroll-mt-24">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-10 text-center">
      <h2 class="text-2xl font-bold text-smartcheck-blue mb-6">¿Está de acuerdo con estos Términos?</h2>
      <!-- Amarillo de marca con texto azul (contraste 4.6:1, texto grande): se separa de los títulos azules. -->
      <a id="boton-aceptar" href={enlaceWhatsApp} class="inline-flex items-center justify-center w-full md:w-auto min-h-[3.5rem] bg-smartcheck-accent hover:brightness-95 text-smartcheck-blue font-bold py-4 px-5 md:px-10 rounded-xl text-lg md:text-xl shadow-lg shadow-smartcheck-accent/40 ring-2 ring-smartcheck-blue/10 hover:shadow-xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-smartcheck-blue/40 transition">
        <svg class="w-6 h-6 mr-3 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
        Acepto los términos y condiciones
      </a>
    </div>
  </section>

  <dialog
    id="confirmar-aceptacion"
    aria-labelledby="confirmar-titulo"
    aria-describedby="confirmar-descripcion"
    class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl p-6 text-left shadow-xl backdrop:bg-black/50"
  >
    <h2 id="confirmar-titulo" class="text-xl font-bold text-smartcheck-blue mb-3">Confirmar aceptación</h2>
    <div id="confirmar-descripcion" class="text-gray-700">
      <p class="mb-3">WhatsApp se va a abrir con este mensaje para SmartCheck:</p>
      <p class="mb-3 font-medium text-gray-900">“{mensaje}”</p>
      <p class="mb-6">La aceptación cuenta cuando el mensaje se envía.</p>
    </div>
    <div class="flex flex-col gap-3">
      <a id="abrir-whatsapp" href={enlaceWhatsApp} autofocus class="inline-flex items-center justify-center w-full bg-smartcheck-blue hover:bg-smartcheck-blue/90 text-white font-medium py-3 px-6 rounded-lg text-lg transition-colors">Abrir WhatsApp</a>
      <button id="cerrar-confirmacion" type="button" class="w-full py-2 text-gray-600 hover:text-gray-900 underline underline-offset-4">Volver</button>
    </div>
  </dialog>

  <script>
    // Si el JS falla, o el navegador no trae <dialog>, el botón sigue siendo un enlace
    // directo a WhatsApp. Aquí solo se intercepta el clic cuando el diálogo sí funciona.
    const boton = document.getElementById('boton-aceptar');
    const dialogo = document.getElementById('confirmar-aceptacion') as HTMLDialogElement | null;
    const volver = document.getElementById('cerrar-confirmacion');
    const abrir = document.getElementById('abrir-whatsapp');

    if (boton && dialogo && volver && abrir && typeof dialogo.showModal === 'function') {
      boton.addEventListener('click', (e) => {
        e.preventDefault();
        dialogo.showModal();
        abrir.focus();
      });
      volver.addEventListener('click', () => dialogo.close());
      dialogo.addEventListener('close', () => boton.focus());
    }
  </script>
</BaseLayout>
